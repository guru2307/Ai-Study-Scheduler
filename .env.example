# AI Study Scheduler - environment variables
# Copy this file to ".env" and fill in your real API key.
# Never commit your actual .env file to version control.

# Which AI provider to use: "anthropic" or "gemini".
AI_PROVIDER=anthropic

# API key for whichever provider you selected above.
#   - Anthropic: get a key at https://console.anthropic.com
#   - Gemini:    get a key at https://aistudio.google.com/apikey
AI_API_KEY=your_api_key_here

# Optional: override the default model for the selected provider.
#   - Anthropic default: claude-sonnet-4-6
#   - Gemini default:    gemini-2.5-flash
AI_MODEL=
